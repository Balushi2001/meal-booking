# انسخ هذا الملف إلى .env وعدّل القيم
PORT=3000
APP_TZ=Asia/Muscat
SESSION_SECRET=change-me-to-a-long-random-string
# اجعلها 1 عند التشغيل خلف HTTPS
COOKIE_SECURE=0
SITE_URL=http://localhost:3000

# كلمات مرور الحسابات الجاهزة (تُستخدم عند أول تشغيل فقط)
ADMIN_PASSWORD=admin12345
KIOSK_PASSWORD=kiosk12345

# WhatsApp Business Cloud API (اتركها فارغة لتسجيل الرسائل فقط دون إرسال)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REMINDER_TEMPLATE=

# بوابة الدفع: mock = تجريبية
PAYMENT_PROVIDER=mock
