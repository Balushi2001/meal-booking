<%- include('../partials/admin-top') %>
<div class="a-grid">
  <form method="post" action="/admin/settings" class="a-card form">
    <h3>أوقات الحجز والوجبات</h3>
    <div class="form-row">
      <label class="field"><span>إغلاق حجز الغد</span><input type="time" name="cutoff_time" value="<%= s.cutoff_time %>" required></label>
      <label class="field"><span>تذكير واتساب</span><input type="time" name="reminder_time" value="<%= s.reminder_time %>" required></label>
    </div>
    <p class="muted small">أوقات الاستلام تحدد الوجبة الحالية في شاشة الاستلام (الصيغة 06:00-10:00).</p>
    <div class="form-row">
      <label class="field"><span>الإفطار</span><input name="breakfast_window" value="<%= s.breakfast_window %>" dir="ltr" class="ltr-input" required></label>
      <label class="field"><span>الغداء</span><input name="lunch_window" value="<%= s.lunch_window %>" dir="ltr" class="ltr-input" required></label>
      <label class="field"><span>العشاء</span><input name="dinner_window" value="<%= s.dinner_window %>" dir="ltr" class="ltr-input" required></label>
    </div>
    <label class="field"><span>الأندية (مفصولة بفواصل)</span><input name="clubs" value="<%= s.clubs %>" required></label>
    <label class="check"><input type="checkbox" name="allow_cancel" value="1" <%= s.allow_cancel === '1' ? 'checked' : '' %>> السماح للعضو بإلغاء حجز «عند الراتب» قبل الإغلاق</label>
    <h3 class="mt">رسالة التذكير</h3>
    <label class="field"><span>نص الرسالة — المتغيرات: {name} {date} {cutoff} {link}</span>
      <textarea name="reminder_template" rows="3" required><%= s.reminder_template %></textarea></label>
    <label class="field"><span>رابط الموقع في الرسالة</span><input name="site_url" value="<%= s.site_url %>" dir="ltr" class="ltr-input"></label>
    <button class="btn btn-primary">حفظ الإعدادات</button>
  </form>

  <div>
    <section class="a-card">
      <h3>واتساب</h3>
      <% if (whatsappConfigured) { %>
        <p>✅ متصل بـ WhatsApp Business API.</p>
      <% } else { %>
        <p class="note small">لم تُضبط بيانات WhatsApp Business API بعد، لذلك تُسجَّل الرسائل هنا فقط دون إرسال. راجع ملف README لضبط المتغيرات WHATSAPP_TOKEN و WHATSAPP_PHONE_NUMBER_ID.</p>
      <% } %>
      <form method="post" action="/admin/settings/remind-now" data-confirm="إرسال تذكير الآن لكل من لم يحجز للغد؟">
        <button class="btn btn-ghost btn-sm">إرسال التذكير الآن</button>
      </form>
      <h4 class="mt">آخر الرسائل</h4>
      <ul class="log">
        <% for (const m of messages) { %><li><small class="muted"><%= m.created_at %> · <span class="ltr"><%= m.phone %></span> · <%= m.kind %> · <%= m.status %></small><div><%= m.kind === 'otp' ? 'رمز تحقق (مخفي)' : m.body %></div></li><% } %>
        <% if (!messages.length) { %><li class="muted">لا توجد رسائل بعد.</li><% } %>
      </ul>
    </section>
    <section class="a-card">
      <h3>كلمات المرور</h3>
      <form method="post" action="/admin/settings/password" class="form">
        <label class="field"><span>كلمة مرور المشرف الحالية</span><input type="password" name="current" required></label>
        <label class="field"><span>الجديدة</span><input type="password" name="password" minlength="8" required></label>
        <label class="field"><span>تأكيدها</span><input type="password" name="password_confirm" required></label>
        <button class="btn btn-ghost btn-sm">تغيير كلمة مرور المشرف</button>
      </form>
      <form method="post" action="/admin/settings/kiosk-password" class="form mt">
        <label class="field"><span>كلمة مرور حساب شاشة الاستلام (اسم الدخول: kiosk)</span><input type="text" name="password" minlength="8" required></label>
        <button class="btn btn-ghost btn-sm">تغيير</button>
      </form>
    </section>
    <section class="a-card">
      <h3>سجل التدقيق</h3>
      <ul class="log">
        <% for (const a of auditRows) { %><li><small class="muted"><%= a.created_at %> · <%= a.admin_name %></small><div><%= a.action %> <small class="muted ltr"><%= a.details %></small></div></li><% } %>
        <% if (!auditRows.length) { %><li class="muted">لا توجد عمليات بعد.</li><% } %>
      </ul>
    </section>
  </div>
</div>
<%- include('../partials/admin-bottom') %>
